# Beatitude Engine — environment template.
# Copy to .env (git-ignored) or export in your shell. Never commit real values.

# --- Model reviewers -------------------------------------------------------
# Grok (xAI) — the default single reviewer. REQUIRED for review().
XAI_API_KEY=
# Council members — required only when a "Closely Aligned" verdict escalates.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides (defaults shown).
# GROK_MODEL=grok-4
# ANTHROPIC_MODEL=claude-opus-5
# OPENAI_MODEL=gpt-5
# XAI_BASE_URL=https://api.x.ai/v1

# --- Supabase audit trail --------------------------------------------------
# Project: beatitude-engine (krzagogtzyuoeyhcpuqo). REQUIRED — every verdict is
# logged before review() returns. The service-role key is server-side only:
# Supabase Dashboard -> Project Settings -> API Keys.
SUPABASE_URL=https://krzagogtzyuoeyhcpuqo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Behavior switches -----------------------------------------------------
# Set to 'off' ONLY for local/eval runs where you explicitly don't want eval
# verdicts written to the production audit table. Default: on.
# BEATITUDE_PERSIST=on

# Override the rubric location (default: rubric/rubric.v1.md).
# BEATITUDE_RUBRIC_PATH=

# --- Cloudflare Worker -----------------------------------------------------
# The Worker takes the same model + Supabase values as secrets, plus a bearer
# token callers must present. Set via `wrangler secret put <NAME>` (see
# worker/wrangler.jsonc) — not via this file.
# BEATITUDE_AUTH_TOKEN=
